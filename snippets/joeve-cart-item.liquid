{% comment %}
  Article du panier (tiroir Joeve)

  @param {object} item - Ligne du panier
  @param {integer} index - Position de la ligne (1, 2, 3...)
{% endcomment %}

{%- liquid
  assign compare = item.variant.compare_at_price | default: 0
  if item.original_price > compare
    assign compare = item.original_price
  endif

  assign details = ''
  unless item.product.has_only_default_variant
    assign details = item.options_with_values | map: 'value' | join: ' - '
  endunless
-%}

<xo-product
  class="xo-cart-mini-item joeve-cart-item"
  xo-section-id="mini-cart"
  xo-product-id="{{ item.product_id }}"
  xo-line="{{ index }}"
>
  <a href="{{ item.url }}" class="joeve-cart-item__media" aria-label="{{ item.product.title | escape }}">
    {%- if item.image != blank -%}
      <img
        src="{{ item.image | image_url: width: 360 }}"
        alt="{{ item.image.alt | default: item.product.title | escape }}"
        width="180"
        height="{{ 180 | divided_by: item.image.aspect_ratio | round }}"
        loading="lazy"
      >
    {%- endif -%}
  </a>

  <div class="joeve-cart-item__info">
    <div class="joeve-cart-item__top">
      <div class="joeve-cart-item__text">
        <a href="{{ item.url }}" class="joeve-cart-item__title">{{ item.product.title | escape }}</a>
        {%- if details != blank -%}
          <span class="joeve-cart-item__options">{{ details }}</span>
        {%- endif -%}
        {%- for property in item.properties -%}
          {%- assign first_char = property.first | slice: 0 -%}
          {%- if property.last != blank and first_char != '_' -%}
            <span class="joeve-cart-item__options">{{ property.first }} : {{ property.last }}</span>
          {%- endif -%}
        {%- endfor -%}
        {%- for discount in item.line_level_discount_allocations -%}
          <span class="joeve-cart-item__discount">{{ discount.discount_application.title }}</span>
        {%- endfor -%}
      </div>
      <div class="joeve-cart-item__price">
        <span>{{ item.final_price | money }}</span>
        {%- if compare > item.final_price -%}
          <s>{{ compare | money }}</s>
        {%- endif -%}
      </div>
    </div>

    <div class="joeve-cart-item__actions">
      {% render 'quantity-2', value: item.quantity, variant: item.variant, product: item.product, is_cart: true, size: 'sm' %}
      <div class="joeve-cart-item__remove">
        <xo-cart-change-fallback class="joeve-cart-item__loading">
          {% render 'loader-2' %}
        </xo-cart-change-fallback>
        <xo-cart-remove class="joeve-cart-item__x" tabindex="0" role="button" aria-label="{{ 'sections.cart.delete' | t }}">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="1.3"/>
          </svg>
        </xo-cart-remove>
      </div>
    </div>
  </div>
</xo-product>
