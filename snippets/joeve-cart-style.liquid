{% comment %}
  Style et script du tiroir panier Joeve.
{% endcomment %}

{%- liquid
  assign joeve_light = settings.type_body_font | font_modify: 'weight', '300'
  assign joeve_regular = settings.type_body_font | font_modify: 'weight', '400'
-%}

<style>
  {{ joeve_light | font_face: font_display: 'swap' }}
  {{ joeve_regular | font_face: font_display: 'swap' }}

  .joeve-cart {
    --joeve-cart-font: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
  }

  .joeve-cart .xo-modal-content__inner {
    padding: 0 !important;
    background: #ffffff !important;
    color: #111111;
    font-family: var(--joeve-cart-font);
    font-weight: 300;
  }

  /* Sur téléphone : le panier monte depuis le bas (voir snippets/cart-mini.liquid) */
  @media (max-width: 749px) {
    .joeve-cart,
    .joeve-cart .xo-modal-content__inner {
      width: 100vw !important;
      min-width: 0 !important;
      max-width: 100vw !important;
      height: 88vh !important;
      height: 88dvh !important;
      max-height: 88dvh !important;
    }

    .joeve-cart .xo-modal-content__inner {
      border-radius: 1.6rem 1.6rem 0 0;
      overflow: hidden;
    }

    /* Petite barre de prise en haut, comme sur les applis */
    .joeve-cart .xo-modal-content__inner::before {
      content: '';
      position: absolute;
      top: 0.8rem;
      left: 50%;
      width: 4rem;
      height: 0.4rem;
      border-radius: 1rem;
      background: #d9d2cb;
      transform: translateX(-50%);
      z-index: 3;
    }
  }

  .joeve-cart h3,
  .joeve-cart h4,
  .joeve-cart button,
  .joeve-cart select,
  .joeve-cart input {
    font-family: inherit;
  }

  /* En-tête */
  .joeve-cart .joeve-cart__header {
    padding: 2.4rem 2rem 1.6rem !important;
    border: 0 !important;
  }

  .joeve-cart .joeve-cart__title {
    margin: 0;
    font-size: 1.7rem !important;
    font-weight: 400 !important;
    letter-spacing: 0;
    color: #111111 !important;
  }

  .joeve-cart .xo-modal-content__body {
    overscroll-behavior: contain;
  }

  .joeve-cart .joeve-cart__content {
    padding: 0 !important;
  }

  /* Livraison offerte */
  .joeve-cart-ship {
    position: sticky;
    top: 0;
    z-index: 2;
    padding: 0 2rem 1.6rem;
    background: #ffffff;
  }

  .joeve-cart-ship__text {
    margin: 0 0 1rem;
    font-size: 1.4rem;
    line-height: 1.4;
    color: #444444;
  }

  .joeve-cart-ship__text strong {
    color: #111111;
    font-weight: 400;
  }

  .joeve-cart-ship__bar {
    display: block;
    height: 0.4rem;
    border-radius: 1rem;
    background: #efe6e0;
    overflow: hidden;
  }

  .joeve-cart-ship__bar > span {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: #8c1c16;
    transition: width 0.4s ease;
  }

  /* Articles */
  .joeve-cart-items {
    padding: 0 2rem;
  }

  .joeve-cart-item {
    display: flex;
    gap: 1.4rem;
    padding: 1.6rem 0 2.4rem;
  }

  .joeve-cart-item + .joeve-cart-item {
    border-top: 1px solid #ececec;
  }

  .joeve-cart-item__media {
    flex: 0 0 10rem;
    width: 10rem;
    background: #f4ede6;
  }

  .joeve-cart-item__media img {
    display: block;
    width: 100%;
    height: auto;
  }

  .joeve-cart-item__info {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
  }

  .joeve-cart-item__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }

  .joeve-cart-item__text {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    min-width: 0;
  }

  .joeve-cart-item__title {
    font-size: 1.6rem;
    font-weight: 400;
    line-height: 1.3;
    color: #111111;
    text-decoration: none;
  }

  .joeve-cart-item__options {
    font-size: 1.35rem;
    line-height: 1.4;
    color: #777777;
  }

  .joeve-cart-item__discount {
    font-size: 1.25rem;
    color: #8c1c16;
  }

  .joeve-cart-item__price {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    flex-shrink: 0;
    gap: 0.2rem;
    font-size: 1.6rem;
    font-weight: 400;
    white-space: nowrap;
  }

  .joeve-cart-item__price s {
    font-size: 1.3rem;
    color: #8c1c16;
  }

  .joeve-cart-item__actions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.8rem;
  }

  .joeve-cart-item .xo-quantity-base {
    width: 8.8rem;
    max-width: 8.8rem;
    height: 3.2rem;
    padding: 0 0.6rem !important;
    border: 1px solid #8e8e8e;
    background: #ffffff;
  }

  .joeve-cart-item .xo-quantity-base__button {
    background: transparent !important;
    color: #111111 !important;
  }

  .joeve-cart-item .xo-quantity-base__input {
    font-size: 1.4rem !important;
    font-weight: 300 !important;
    background: transparent;
  }

  .joeve-cart-item__remove {
    position: relative;
    display: flex;
    align-items: center;
  }

  .joeve-cart-item__x {
    display: flex;
    padding: 0.4rem;
    color: #111111;
    cursor: pointer;
  }

  .joeve-cart-item__loading {
    display: none;
  }

  .joeve-cart-item__loading[xo-visible] {
    display: flex;
    position: absolute;
    inset: 0;
    align-items: center;
    justify-content: center;
    background: #ffffff;
  }

  /* Complétez votre look */
  .joeve-recos {
    padding: 2.2rem 0 2rem 2rem;
  }

  .joeve-recos__title {
    margin: 0 0 1.4rem;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #111111;
  }

  .joeve-recos__track {
    display: flex;
    gap: 1.2rem;
    padding-right: 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .joeve-recos__track::-webkit-scrollbar {
    display: none;
  }

  .joeve-reco {
    display: flex;
    gap: 1.2rem;
    flex: 0 0 86%;
    padding: 1.2rem;
    border-radius: 0.8rem;
    background: #f4ede6;
    scroll-snap-align: start;
  }

  .joeve-reco__media {
    flex: 0 0 8.4rem;
    width: 8.4rem;
  }

  .joeve-reco__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 0.4rem;
  }

  .joeve-reco__body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex: 1;
    min-width: 0;
  }

  .joeve-reco__title {
    overflow: hidden;
    font-size: 1.35rem;
    line-height: 1.35;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: #111111;
    text-decoration: none;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .joeve-reco__price {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
    font-size: 1.4rem;
  }

  .joeve-reco__price s {
    color: #8a8a8a;
  }

  .joeve-reco__price span {
    font-weight: 600;
  }

  .joeve-reco__row {
    display: flex;
    gap: 0.8rem;
    margin-top: auto;
  }

  .joeve-reco__select {
    flex: 1;
    min-width: 0;
    height: 3.8rem;
    padding: 0 1rem;
    border: 1px solid #d6d6d6;
    border-radius: 0;
    background: #ffffff;
    font-size: 1.3rem;
    color: #111111;
  }

  .joeve-reco__add {
    display: block;
    flex-shrink: 0;
  }

  .joeve-reco__add button {
    height: 3.8rem;
    padding: 0 1.6rem;
    border: 0;
    border-radius: 0;
    background: #000000;
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .joeve-reco__add[xo-loading] button {
    opacity: 0.5;
    pointer-events: none;
  }

  /* Bas du panier */
  .joeve-cart .joeve-cart__footer {
    padding: 1.4rem 2rem 1.6rem !important;
    border-top: 1px solid #ececec;
    background: #ffffff;
  }

  .joeve-cart-footer__savings {
    display: flex;
    justify-content: space-between;
    padding: 1.1rem 1.4rem;
    background: #f6f2ee;
    font-size: 1.45rem;
  }

  .joeve-cart-footer__savings-amount {
    color: #8c1c16;
  }

  .joeve-cart-footer__row {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 1.2rem;
    font-size: 1.5rem;
  }

  .joeve-cart-footer__row small {
    font-size: 1.3rem;
    color: #777777;
  }

  .joeve-cart-footer__ship-price {
    flex-shrink: 0;
    white-space: nowrap;
  }

  .joeve-cart-footer__dates {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    margin-top: 0.4rem;
    font-size: 1.25rem;
    color: #555555;
  }

  .joeve-cart-footer__dates:empty {
    display: none;
  }

  .joeve-cart-footer__dates::before {
    content: '';
    flex-shrink: 0;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 50%;
    background: #3dd068;
  }

  .joeve-cart-footer__row--total {
    align-items: baseline;
    font-size: 1.6rem;
  }

  .joeve-cart-footer__row--total strong {
    font-size: 1.7rem;
    font-weight: 400;
  }

  .joeve-cart-footer__discount {
    margin-top: 0.4rem;
    font-size: 1.25rem;
    color: #8c1c16;
  }

  .joeve-cart-footer__form {
    margin: 1.6rem 0 0;
  }

  .joeve-cart-footer__checkout {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 4.8rem;
    border: 0;
    border-radius: 0;
    background: #000000;
    color: #ffffff;
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
    cursor: pointer;
  }

  .joeve-cart-footer__dynamic {
    margin-top: 1rem;
  }

  .joeve-cart-footer__payments {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem;
    margin: 1.2rem 0 0;
    padding: 0;
    list-style: none;
  }

  .joeve-cart-footer__payments svg {
    display: block;
    width: auto;
    height: 2.2rem;
  }

  .joeve-cart-footer__note {
    margin: 0.8rem 0 0;
    font-size: 1.2rem;
    text-align: center;
    color: #777777;
  }

  .joeve-cart:has(.joeve-cart-is-empty) .joeve-cart-footer__static {
    display: none;
  }
</style>

<script>
  (function () {
    if (window.joeveCartReady) return;
    window.joeveCartReady = true;

    // Dates de livraison (mêmes règles que la ligne « En stock » de la page produit)
    if (!customElements.get('joeve-ship-dates')) {
      customElements.define(
        'joeve-ship-dates',
        class extends HTMLElement {
          connectedCallback() {
            var min = parseInt(this.dataset.min, 10) || 0;
            var max = parseInt(this.dataset.max, 10) || min;
            var business = this.dataset.business === 'true';
            var add = function (days) {
              var d = new Date();
              if (business) {
                // Jours ouvrés : on ne compte ni le samedi ni le dimanche
                var added = 0;
                while (added < days) {
                  d.setDate(d.getDate() + 1);
                  if (d.getDay() !== 0 && d.getDay() !== 6) added++;
                }
              } else {
                d.setDate(d.getDate() + days);
              }
              return d.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long' });
            };
            this.textContent = 'Livrée entre ' + add(min) + ' et ' + add(max);
          }
        }
      );
    }

    // Choix de la taille dans « Complétez votre look »
    document.addEventListener('change', function (event) {
      var select = event.target;
      if (!select.matches || !select.matches('.joeve-reco__select')) return;
      var add = select.closest('.joeve-reco').querySelector('.joeve-reco__add');
      if (add) add.setAttribute('xo-product-id', select.value);
    });
  })();
</script>
