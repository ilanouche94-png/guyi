{% comment %}
  « Compléter votre look » : carrousel de 5 produits dans le tiroir panier.
  Produits pris dans la collection du premier article du panier
  (ou dans la collection choisie dans Paramètres du thème > Panier).
{% endcomment %}

{%- liquid
  assign in_cart = ','
  for item in cart.items
    assign in_cart = in_cart | append: item.product_id | append: ','
  endfor

  assign source = blank
  for item in cart.items
    if source != blank
      break
    endif
    for c in item.product.collections
      if c.handle != 'all' and c.handle != 'frontpage' and c.products_count > 1
        assign source = c
        break
      endif
    endfor
  endfor
  if source == blank and settings.cart_drawer_collection != blank
    assign source = collections[settings.cart_drawer_collection]
  endif
-%}

{%- if source != blank -%}
  {%- capture cards -%}
    {%- assign shown = 0 -%}
    {%- for p in source.products limit: 40 -%}
      {%- if shown >= 5 -%}{%- break -%}{%- endif -%}
      {%- assign needle = ',' | append: p.id | append: ',' -%}
      {%- if p.available == false or in_cart contains needle -%}{%- continue -%}{%- endif -%}
      {%- assign shown = shown | plus: 1 -%}
      <a href="{{ p.url }}" class="joeve-reco">
        <span class="joeve-reco__media">
          {%- if p.featured_image != blank -%}
            <img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.featured_image.alt | default: p.title | escape }}" width="200" height="250" loading="lazy">
          {%- endif -%}
        </span>
        <span class="joeve-reco__title">{{ p.title | escape }}</span>
        <span class="joeve-reco__price">
          {{- p.price | money -}}
          {%- if p.compare_at_price > p.price -%} <s>{{ p.compare_at_price | money }}</s>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  {%- endcapture -%}

  {%- if shown > 0 -%}
    <div class="joeve-recos">
      <h4 class="joeve-recos__title">Compléter votre look</h4>
      <div class="joeve-recos__track">{{ cards }}</div>
    </div>
  {%- endif -%}
{%- endif -%}
