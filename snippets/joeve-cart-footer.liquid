{% comment %}
  Bas du tiroir panier Joeve : économies, livraison, total, paiement.

  @param {number} joeve_ship_price - Prix de la livraison en centimes
  @param {number} joeve_free_from - Livraison offerte à partir de (centimes)
  @param {number} joeve_ship_min_days - Livraison au plus tôt (jours)
  @param {number} joeve_ship_max_days - Livraison au plus tard (jours)
{% endcomment %}

{%- liquid
  assign savings = 0
  for item in cart.items
    assign unit_compare = item.variant.compare_at_price | default: 0
    if item.original_price > unit_compare
      assign unit_compare = item.original_price
    endif
    assign line_compare = unit_compare | times: item.quantity
    if line_compare > item.final_line_price
      assign savings = savings | plus: line_compare | minus: item.final_line_price
    endif
  endfor
  if cart.items_subtotal_price > cart.total_price
    assign savings = savings | plus: cart.items_subtotal_price | minus: cart.total_price
  endif

  if cart.total_price >= joeve_free_from
    assign shipping = 0
  else
    assign shipping = joeve_ship_price
  endif
  assign grand_total = cart.total_price | plus: shipping
-%}

<div class="joeve-cart-footer">
  <xo-cart-will-change xo-unique-id="xo-cart-mini-footer-drawer">
    {%- if cart != empty -%}
      {%- if savings > 0 -%}
        <div class="joeve-cart-footer__savings">
          <span>{{ 'joeve.cart.savings' | t }}</span>
          <span class="joeve-cart-footer__savings-amount">-<span class="money">{{ savings | money }}</span></span>
        </div>
      {%- endif -%}

      <div class="joeve-cart-footer__row">
        <span>
          {{ 'joeve.cart.shipping' | t }} <small>{{ 'joeve.cart.tracked' | t }}</small>
          <joeve-ship-dates-i18n
            class="joeve-cart-footer__dates"
            data-min="{{ joeve_ship_min_days }}"
            data-max="{{ joeve_ship_max_days }}"
            data-business="true"
            data-template="{{ 'joeve.cart.delivered_between' | t | escape }}"
            data-locale="{{ request.locale.iso_code }}"
          ></joeve-ship-dates-i18n>
        </span>
        <span class="joeve-cart-footer__ship-price">
          {%- if shipping == 0 -%}{{ 'joeve.cart.free' | t }}{%- else -%}<joeve-flat-price data-value="{{ shipping | divided_by: 100.0 }}">{{ shipping | money }}</joeve-flat-price>{%- endif -%}
        </span>
      </div>

      <div class="joeve-cart-footer__row joeve-cart-footer__row--total">
        <span>{{ 'joeve.cart.total' | t }}</span>
        <strong><span class="money">{{ grand_total | money }}</span></strong>
      </div>

      {%- for discount in cart.cart_level_discount_applications -%}
        <div class="joeve-cart-footer__discount">{{ discount.title }} (-<span class="money">{{ discount.total_allocated_amount | money }}</span>)</div>
      {%- endfor -%}
    {%- endif -%}
  </xo-cart-will-change>

  <div class="joeve-cart-footer__static">
    <details class="joeve-promo">
      <summary class="joeve-promo__toggle">{{ 'joeve.cart.promo_question' | t }}<span aria-hidden="true">+</span></summary>
      <form class="joeve-promo__form" data-joeve-promo>
        <input
          class="joeve-promo__input"
          type="text"
          name="discount"
          autocomplete="off"
          autocapitalize="characters"
          placeholder="{{ 'joeve.cart.promo_placeholder' | t | escape }}"
          aria-label="{{ 'joeve.cart.promo_placeholder' | t | escape }}"
          required
        >
        <button type="submit" class="joeve-promo__apply">{{ 'joeve.cart.promo_apply' | t }}</button>
      </form>
      <p
        class="joeve-promo__message"
        data-joeve-promo-message
        data-ok="{{ 'joeve.cart.promo_applied' | t | escape }}"
        data-invalid="{{ 'joeve.cart.promo_invalid' | t | escape }}"
        hidden
      ></p>
    </details>

    <form action="{{ routes.cart_url }}" method="post" class="joeve-cart-footer__form">
      <button type="submit" name="checkout" class="joeve-cart-footer__checkout">
        <span>{{ 'joeve.cart.checkout' | t }}</span>
      </button>
    </form>

    {%- if additional_checkout_buttons -%}
      <div class="joeve-cart-footer__dynamic">{{ content_for_additional_checkout_buttons }}</div>
    {%- endif -%}

    {%- if shop.enabled_payment_types.size > 0 -%}
      <ul class="joeve-cart-footer__payments" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <script>
      // Dates de livraison dans la langue du visiteur (texte : locales > joeve.cart.delivered_between)
      if (!customElements.get('joeve-ship-dates-i18n')) {
        customElements.define('joeve-ship-dates-i18n', class extends HTMLElement {
          connectedCallback() {
            var min = parseInt(this.dataset.min, 10) || 0;
            var max = parseInt(this.dataset.max, 10) || min;
            var business = this.dataset.business === 'true';
            var locale = this.dataset.locale || document.documentElement.lang || 'en';
            var add = function (days) {
              var d = new Date();
              if (business) {
                var added = 0;
                while (added < days) {
                  d.setDate(d.getDate() + 1);
                  if (d.getDay() !== 0 && d.getDay() !== 6) added++;
                }
              } else {
                d.setDate(d.getDate() + days);
              }
              return d.toLocaleDateString(locale, { weekday: 'long', day: 'numeric', month: 'long' });
            };
            var template = this.dataset.template || '[from] – [to]';
            this.textContent = template.replace('[from]', add(min)).replace('[to]', add(max));
          }
        });
      }

      // Code promo : appliqué au panier sans recharger la page
      if (!window.joevePromoReady) {
        window.joevePromoReady = true;
        document.addEventListener('submit', async function (event) {
          var form = event.target.closest && event.target.closest('[data-joeve-promo]');
          if (!form) return;
          event.preventDefault();
          var input = form.querySelector('input');
          var button = form.querySelector('button');
          var message = form.parentElement.querySelector('[data-joeve-promo-message]');
          var code = input.value.trim();
          if (!code) return;
          var root = (window.Shopify && window.Shopify.routes && window.Shopify.routes.root) || '/';
          var cartMini = document.querySelector('xo-cart-mini');
          button.disabled = true;
          try {
            var current = await fetch(root + 'cart.js').then(function (r) { return r.json(); });
            var codes = (current.discount_codes || []).map(function (d) { return d.code; });
            if (codes.indexOf(code) === -1) codes.push(code);
            var res = await fetch(root + 'cart/update.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ discount: codes.join(','), sections: cartMini ? cartMini.id : undefined })
            });
            var cart = await res.json();
            var applied = (cart.discount_codes || []).some(function (d) {
              return d.code.toLowerCase() === code.toLowerCase() && d.applicable;
            });
            message.hidden = false;
            message.textContent = applied ? message.dataset.ok : message.dataset.invalid;
            message.classList.toggle('is-error', !applied);
            if (!applied) {
              // On retire le code refusé pour ne pas le garder dans le panier
              await fetch(root + 'cart/update.js', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ discount: codes.filter(function (c) { return c !== code; }).join(',') })
              });
              return;
            }
            input.value = '';
            // Met à jour les montants du panier (total, économies, remises)
            var html = cart.sections && cartMini && cart.sections[cartMini.id];
            if (html) {
              var doc = new DOMParser().parseFromString(html, 'text/html');
              document.querySelectorAll('xo-cart-will-change[xo-unique-id]').forEach(function (el) {
                var fresh = doc.querySelector('xo-cart-will-change[xo-unique-id="' + el.getAttribute('xo-unique-id') + '"]');
                if (fresh && fresh.innerHTML !== el.innerHTML) el.innerHTML = fresh.innerHTML;
              });
            }
          } catch (e) {
            message.hidden = false;
            message.textContent = message.dataset.invalid;
            message.classList.add('is-error');
          } finally {
            button.disabled = false;
          }
        });
      }

      // Livraison : même montant (3,90) quelle que soit la devise affichée par BUCKS
      if (!customElements.get('joeve-flat-price')) {
        customElements.define('joeve-flat-price', class extends HTMLElement {
          connectedCallback() {
            var self = this;
            var total = function () {
              var footer = self.closest('.joeve-cart-footer');
              return footer && footer.querySelector('.joeve-cart-footer__row--total .money');
            };
            var apply = function () {
              var t = total();
              var text = t ? t.textContent.trim() : '';
              var match = text.match(/\d[\d\s.,]*\d|\d/);
              if (!match) return;
              var comma = /,\d{1,2}$/.test(match[0]);
              var value = parseFloat(self.dataset.value).toFixed(2);
              if (comma) value = value.replace('.', ',');
              var next = text.replace(match[0], value);
              if (self.textContent !== next) self.textContent = next;
            };
            apply();
            var t = total();
            if (t) new MutationObserver(apply).observe(t, { childList: true, characterData: true, subtree: true });
          }
        });
      }
    </script>

    <p class="joeve-cart-footer__note">{{ 'joeve.cart.returns_note' | t }}</p>
  </div>
</div>
