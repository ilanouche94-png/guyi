{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{% liquid
  if settings.cart_type == 'drawer'
    if settings.cart_drawer_placement == 'left'
      assign animate = 'slide-right'
      assign placement = 'top-left'
    else
      assign animate = 'slide-left'
      assign placement = 'top-right'
    endif
  elsif settings.cart_type == 'notification'
    assign animate = 'fade-up'
    assign placement = 'center'
  endif
%}

{% if settings.cart_type != 'page' %}
  <xo-modal
    xo-section-select
    xo-portal
    xo-name="cart"
    xo-animate="{{ animate }}"
    xo-placement="{{ placement }}"
    xo-duration="400"
    xo-for-cart-mini
    class="color-{{ settings.cart_color_scheme }}"
    style="z-index: 9999;"
    {% if settings.cart_type == 'notification' %}
      xo-breakpoints="
        {
          992: {
            disabled: false,
            placement: 'center',
            animate: 'fade-up'
          }
        }
      "
    {% endif %}
    {% if settings.cart_type == 'drawer' %}
      {% comment %} Joeve : sur téléphone (749 px et moins), le panier monte depuis le bas. {% endcomment %}
      xo-breakpoints="
        {
          749: {
            placement: 'bottom-center',
            animate: 'slide-up'
          }
        }
      "
    {% endif %}
  >
    <xo-cart-mini
      id="xo-cart-mini"
      class="xo-cart-mini"
      {% if settings.cart_type == 'notification' %}
        xo-notification
      {% endif %}
    >
      {% case settings.cart_type %}
        {% when 'drawer' %}
          {% render 'cart-drawer', button_content: button_content %}
        {% when 'notification' %}
          {% render 'cart-notification', button_content: button_content %}
        {% else %}
          {% render 'cart-drawer', button_content: button_content %}
      {% endcase %}
    </xo-cart-mini>
  </xo-modal>
{% endif %}
