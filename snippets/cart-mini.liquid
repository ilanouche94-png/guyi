{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{% liquid
  if settings.cart_type == 'drawer'
    if settings.cart_drawer_placement == 'left'
      assign animate = 'slide-right'
      assign placement = 'top-left'
    else
      assign animate = 'slide-left'
      assign placement = 'top-right'
    endif
  elsif settings.cart_type == 'notification'
    assign animate = 'fade-up'
    assign placement = 'center'
  endif
%}

{% if settings.cart_type != 'page' %}
  <xo-modal
    xo-section-select
    xo-portal
    xo-name="cart"
    xo-animate="{{ animate }}"
    xo-placement="{{ placement }}"
    xo-duration="400"
    xo-for-cart-mini
    class="color-{{ settings.cart_color_scheme }}"
    style="z-index: 9999;"
    {% if settings.cart_type == 'notification' %}
      xo-breakpoints="
        {
          992: {
            disabled: false,
            placement: 'center',
            animate: 'fade-up'
          }
        }
      "
    {% endif %}
  >
    <xo-cart-mini
      id="xo-cart-mini"
      class="xo-cart-mini"
      {% if settings.cart_type == 'notification' %}
        xo-notification
      {% endif %}
    >
      {% case settings.cart_type %}
        {% when 'drawer' %}
          {% render 'cart-drawer', button_content: button_content %}
        {% when 'notification' %}
          {% render 'cart-notification', button_content: button_content %}
        {% else %}
          {% render 'cart-drawer', button_content: button_content %}
      {% endcase %}
    </xo-cart-mini>
  </xo-modal>

  {%- if settings.cart_type == 'drawer' -%}
    <script>
      // Joeve : sur téléphone, le panier monte depuis le bas au lieu d'arriver par le côté.
      // Réglé avant le chargement du thème, qui lit ces attributs au démarrage.
      (function () {
        if (!window.matchMedia('(max-width: 749px)').matches) return;
        var modal = document.querySelector('xo-modal[xo-name="cart"]');
        if (!modal) return;
        modal.setAttribute('xo-animate', 'slide-up');
        modal.setAttribute('xo-placement', 'bottom-center');
      })();
    </script>
  {%- endif -%}
{% endif %}
