{%- liquid
  assign product = block.settings.product

  # Style Kayo : libellé au-dessus, boutons en dessous
  assign inner_class = 'd:flex gp:s4 fld:column joeve-variants__option'
  assign container_class = 'xo-product-variant__inner d:flex fld:column gp:var(--container-gap) joeve-variants'
  assign option_label_class = 'xo-product-variant__inner-name joeve-variants__label'
  assign option_value_class = 'xo-product-variant__inner-value d:flex ai:center gp:var(--gap) joeve-variants__values'
  assign container_style = ''

  assign container_gap = block.settings.option_spacing | divided_by: 10.0
  assign container_style = '--container-gap: ' | append: container_gap | append: 'rem;'
  assign spacing = block.settings.option_value_spacing | divided_by: 10.0
  assign option_value_style = '--gap: ' | append: spacing | append: 'rem;'

  if block.settings.inherit_color_scheme != true
    assign container_class = container_class | append: ' color-' | append: block.settings.color_scheme
  endif

  # Padding
  capture padding_attrs
    render 'padding-attrs', context: block
  endcapture
  assign padding_attrs = padding_attrs | split: 'COMMA'
  assign padding_class = padding_attrs[0] | strip
  assign padding_style = padding_attrs[1] | strip
  assign container_class = container_class | append: ' ' | append: padding_class
  assign container_style = container_style | append: padding_style
-%}

{% capture content %}
  {% unless product.has_only_default_variant %}
    <style>
  .joeve-variants {
    --joeve-picker-text: {{ block.settings.size_text_color }};
    --joeve-picker-muted: {{ block.settings.size_soldout_color }};
  }

  .joeve-variants .joeve-variants__option {
    gap: 1.2rem;
  }

  .joeve-variants .joeve-variants__label {
    font-size: 1.5rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--joeve-picker-text);
  }

  /* Tailles en simple texte, sans cadre */
  .joeve-variants .joeve-variants__values {
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    column-gap: {{ block.settings.size_gap }}px !important;
    row-gap: 1.2rem !important;
  }

  .joeve-variants .xo-field-toggle__diagonal {
    display: none !important;
  }

  /* Toutes les tailles restent cliquables (vente possible même sans stock) */
  .joeve-variants .xo-field-toggle,
  .joeve-variants .xo-field-toggle:has(.xo-field-toggle__input[xo-disabled]),
  .joeve-variants .xo-field-toggle:has(.xo-field-toggle__input[xo-unavailable]) {
    display: inline-flex !important;
    pointer-events: auto !important;
    cursor: pointer !important;
  }

  .joeve-variants .xo-field-toggle__text {
    display: inline-block !important;
    min-width: 0 !important;
    width: auto !important;
    height: auto !important;
    padding: 0.2rem 0 0.4rem !important;
    border: 0 !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    color: var(--joeve-picker-text) !important;
    font-size: {{ block.settings.size_font_size }}px !important;
    line-height: 1.2 !important;
    letter-spacing: 0.02em !important;
    text-decoration: none !important;
    opacity: 1 !important;
    transition: color 0.2s ease !important;
  }

  {%- if block.settings.size_grey_soldout %}
  .joeve-variants .xo-field-toggle:has(.xo-field-toggle__input[xo-disabled]) .xo-field-toggle__text,
  .joeve-variants .xo-field-toggle:has(.xo-field-toggle__input[xo-unavailable]) .xo-field-toggle__text {
    color: var(--joeve-picker-muted) !important;
  }
  {%- endif %}

  .joeve-variants .xo-field-toggle:hover .xo-field-toggle__text {
    text-decoration: underline !important;
    text-decoration-thickness: 1px !important;
    text-underline-offset: 0.6rem !important;
  }

  .joeve-variants .xo-field-toggle__input:checked + .xo-field-toggle__text {
    color: var(--joeve-picker-text) !important;
    text-decoration: underline !important;
    text-decoration-thickness: 1px !important;
    text-underline-offset: 0.6rem !important;
  }

  .joeve-variants .xo-field-toggle:focus-visible .xo-field-toggle__text {
    outline: 1px solid var(--joeve-picker-text) !important;
    outline-offset: 3px !important;
  }

  .joeve-variants .joeve-size-guide {
    align-self: flex-start;
    color: var(--joeve-picker-text);
    font-size: {{ block.settings.size_font_size }}px;
    line-height: 1.3;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.5rem;
  }
    </style>
    <xo-product-variants class="{{ container_class }}" style="{{ container_style }}" {{ block.shopify_attributes }}>
      {% for option in product.options_with_values %}
        {% liquid
          assign condition = true
          if block.settings.show_only_first_option
            unless forloop.first
              assign condition = false
            endunless
          endif
        %}

        {% if condition %}
          {% capture variant_name %}
            {%- if block.settings.enable_option_name -%}
              <div class="{{ option_label_class }}">
                {{ option.name }}: <span class="joeve-variants__selected" data-joeve-option="{{ option.name | escape }}">{{ option.selected_value }}</span>
              </div>
            {%- endif -%}
          {% endcapture %}
          {% capture variant_value %}
            {% assign popover_name_suffix = block.id | append: '-' | append: option.name | append: '-' | append: product.id %}
            {%- render 'product-variant-value', option: option, variants_list_style: 'buttons', option_value_class: option_value_class, option_value_style: option_value_style, enable_swatches: block.settings.enable_swatches, popover_name_suffix: popover_name_suffix, placement: 'bottom-right' -%}
          {% endcapture %}
          <div class="{{ inner_class }}">
            {% content_for 'block', type: '_variant-label', id: 'static_variant_name', content: variant_name, cls: 'flxs:0' %}
            {% content_for 'block', type: '_variant-values', id: 'static_variant_value', content: variant_value %}
          </div>
        {% endif %}
      {% endfor %}

      {%- if block.settings.size_guide_url != blank -%}
        <a class="joeve-size-guide" href="{{ block.settings.size_guide_url }}">{{ block.settings.size_guide_label | escape }}</a>
      {%- endif -%}
    </xo-product-variants>
  {% endunless %}
{% endcapture %}

{% render 'animate', cascade: true, content: content, context: block %}



{% javascript %}
  // Met à jour « Size: XS » dès qu'on clique sur une taille.
  document.addEventListener('change', (event) => {
    const input = event.target;
    if (!input.matches || !input.matches('.joeve-variants .xo-field-toggle__input')) return;
    const container = input.closest('.joeve-variants');
    const label = container && container.querySelector(
      '.joeve-variants__selected[data-joeve-option="' + CSS.escape(input.name) + '"]'
    );
    if (label) label.textContent = input.getAttribute('xo-label') || input.value;
  });
{% endjavascript %}

{% schema %}
{
  "name": "t:name.block_variant_picker",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "select",
      "id": "variant",
      "label": "t:settings.style",
      "options": [
        { "value": "dropdowns", "label": "t:options.dropdowns" },
        { "value": "buttons", "label": "t:options.buttons" }
      ],
      "default": "buttons"
    },
    {
      "type": "checkbox",
      "id": "enable_swatches",
      "label": "t:settings.swatches",
      "default": false
    },
    {
      "type": "select",
      "id": "direction",
      "label": "t:settings.direction",
      "options": [
        { "value": "horizontal", "label": "t:options.horizontal" },
        { "value": "vertical", "label": "t:options.vertical" }
      ],
      "default": "vertical"
    },
    {
      "type": "text_alignment",
      "id": "alignment",
      "label": "t:settings.alignment",
      "default": "left"
    },
    {
      "type": "header",
      "content": "Style des tailles"
    },
    {
      "type": "color",
      "id": "size_text_color",
      "label": "Couleur des tailles",
      "default": "#111111"
    },
    {
      "type": "checkbox",
      "id": "size_grey_soldout",
      "label": "Griser les tailles épuisées",
      "info": "Elles restent cliquables.",
      "default": true
    },
    {
      "type": "color",
      "id": "size_soldout_color",
      "label": "Couleur des tailles épuisées",
      "default": "#999591",
      "visible_if": "{{ block.settings.size_grey_soldout == true }}"
    },
    {
      "type": "range",
      "id": "size_font_size",
      "label": "Taille du texte",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 17
    },
    {
      "type": "range",
      "id": "size_gap",
      "label": "Espace entre les tailles",
      "min": 8,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "header",
      "content": "Guide des tailles"
    },
    {
      "type": "url",
      "id": "size_guide_url",
      "label": "Lien du guide des tailles",
      "info": "Laisse vide pour ne pas afficher le lien."
    },
    {
      "type": "text",
      "id": "size_guide_label",
      "label": "Texte du lien",
      "default": "Guide des tailles"
    },
    {
      "type": "checkbox",
      "id": "inherit_color_scheme",
      "label": "t:settings.inherit_color_scheme",
      "default": true
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1",
      "visible_if": "{{ block.settings.inherit_color_scheme == false }}"
    },
    {
      "type": "checkbox",
      "id": "show_only_first_option",
      "label": "t:settings.show_only_first_option",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "enable_option_name",
      "label": "t:settings.enable_option_name",
      "default": true
    },
    {
      "type": "range",
      "id": "option_spacing",
      "label": "t:settings.option_spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "option_value_spacing",
      "label": "t:settings.option_value_spacing",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "select",
      "id": "device_padding",
      "label": "t:settings.device",
      "default": "desktop",
      "options": [
        { "value": "desktop", "label": "t:options.desktop" },
        { "value": "mobile", "label": "t:options.mobile" }
      ]
    },
    {
      "type": "checkbox",
      "id": "inherit_desktop_padding",
      "label": "t:settings.inherit_desktop_value",
      "default": true,
      "visible_if": "{{ block.settings.device_padding == 'mobile' }}"
    },
    {
      "type": "range", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "top_padding_desktop",
      "visible_if": "{{ block.settings.device_padding == 'desktop' }}"
    },
    {
      "type": "range", "label": "t:settings.top", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "top_padding_mobile",
      "visible_if": "{{ block.settings.inherit_desktop_padding == false and block.settings.device_padding == 'mobile' }}"
    },
    {
      "type": "range", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "bottom_padding_desktop",
      "visible_if": "{{ block.settings.device_padding == 'desktop' }}"
    },
    {
      "type": "range", "label": "t:settings.bottom", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "bottom_padding_mobile",
      "visible_if": "{{ block.settings.inherit_desktop_padding == false and block.settings.device_padding == 'mobile' }}"
    },
    {
      "type": "range", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "left_padding_desktop",
      "visible_if": "{{ block.settings.device_padding == 'desktop' }}"
    },
    {
      "type": "range", "label": "t:settings.left", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "left_padding_mobile",
      "visible_if": "{{ block.settings.inherit_desktop_padding == false and block.settings.device_padding == 'mobile' }}"
    },
    {
      "type": "range", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "right_padding_desktop",
      "visible_if": "{{ block.settings.device_padding == 'desktop' }}"
    },
    {
      "type": "range", "label": "t:settings.right", "min": 0, "max": 100, "step": 1, "unit": "px", "default": 0,
      "id": "right_padding_mobile",
      "visible_if": "{{ block.settings.inherit_desktop_padding == false and block.settings.device_padding == 'mobile' }}"
    }
  ],
  "blocks": [],
  "presets": [
    {
      "name": "t:name.block_variant_picker",
      "category": "Product",
      "settings": {
        "product": "{{ closest.product }}"
      },
      "blocks": {
        "static_variant_name": {
          "name": "Label",
          "type": "_variant-label",
          "static": true,
          "settings": {}
        },
        "static_variant_value": {
          "name": "Values",
          "type": "_variant-values",
          "static": true,
          "settings": {}
        }
      }
    }
  ]
}
{% endschema %}
