{%- liquid
  assign container_class = 'jof-delivery'
  assign container_style = ''

  capture padding_attrs
    render 'padding-attrs', context: block
  endcapture
  assign padding_attrs = padding_attrs | split: 'COMMA'
  assign padding_class = padding_attrs[0] | strip
  assign padding_style = padding_attrs[1] | strip
  assign container_class = container_class | append: ' ' | append: padding_class
  assign container_style = container_style | append: padding_style

  assign min_days = block.settings.delivery_min_days
  assign max_days = block.settings.delivery_max_days
  if max_days < min_days
    assign max_days = min_days
  endif

  # Dates calculées côté serveur (affichées si le JavaScript ne tourne pas).
  # Le script plus bas les recalcule avec la date du jour et la langue du visiteur.
  # Texte traduisible : locales/*.json > joeve.delivery.in_stock_between
  assign now_ts = 'now' | date: '%s' | plus: 0

  assign labels = ''
  for target in (1..2)
    if target == 1
      assign wanted = min_days
    else
      assign wanted = max_days
    endif
    assign ts = now_ts
    if block.settings.count_business_days
      assign counted = 0
      for i in (1..40)
        if counted >= wanted
          break
        endif
        assign ts = ts | plus: 86400
        assign weekday = ts | date: '%u' | plus: 0
        if weekday < 6
          assign counted = counted | plus: 1
        endif
      endfor
    else
      assign ts = wanted | times: 86400 | plus: ts
    endif
    assign label = ts | date: '%A %-d %B'
    assign labels = labels | append: label | append: '|'
  endfor
  assign labels = labels | split: '|'
  assign delivery_template = 'joeve.delivery.in_stock_between' | t
  assign delivery_text = delivery_template | replace: '[from]', labels[0] | replace: '[to]', labels[1]
-%}

{% capture content %}
  <style>
    .jof-delivery__row {
      display: flex;
      align-items: center;
      gap: 1.2rem;
      font-size: 1.6rem;
      line-height: 1.4;
      color: {{ block.settings.text_color }};
    }

    .jof-delivery__dot {
      flex-shrink: 0;
      width: 1.2rem;
      height: 1.2rem;
      border-radius: 50%;
      background: {{ block.settings.dot_color }};
    }
  </style>
  <div class="jof-delivery__row">
    <span class="jof-delivery__dot" aria-hidden="true"></span>
    <span
      data-jof-delivery
      data-min="{{ min_days }}"
      data-max="{{ max_days }}"
      data-business="{{ block.settings.count_business_days }}"
      data-template="{{ delivery_template | escape }}"
      data-locale="{{ request.locale.iso_code }}"
    >
      {{- delivery_text -}}
    </span>
  </div>
{% endcapture %}

<div class="{{ container_class }}" style="{{ container_style }}" {{ block.shopify_attributes }}>
  {% render 'animate', cascade: true, context: block, content: content %}
</div>

{%- if block.settings.mobile_sticky and section.id contains 'main_product' -%}
  {%- assign sticky_id = 'jof-sticky-' | append: block.id -%}
  <style>
    #{{ sticky_id }},
    .jof-mstock {
      display: none;
    }

    @media (max-width: 749px) {
      /* Sur téléphone : la ligne livraison et le bouton panier passent dans la barre du bas */
      .jof-delivery,
      .jof-hide-mobile {
        display: none !important;
      }

      body.jof-has-sticky {
        padding-bottom: 11.4rem;
      }

      #{{ sticky_id }} {
        display: block;
        position: fixed;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 50;
        background: {{ block.settings.sticky_bg }};
        font-family: inherit;
      }

      #{{ sticky_id }} .jof-sticky__band {
        display: flex;
        align-items: center;
        gap: 1rem;
        min-height: 2.2rem;
        padding: 0.3rem 1.2rem;
        background: {{ block.settings.band_bg }};
        color: {{ block.settings.text_color }};
        font-size: 1.3rem;
        line-height: 1.3;
      }

      /* Livraison + stock, juste sous le prix (déplacé par le script plus bas) */
      .jof-mstock {
        display: flex;
        flex-direction: column;
        gap: 0.6rem;
        margin-top: 1rem;
        font-size: 1.35rem;
        line-height: 1.35;
        color: {{ block.settings.text_color }};
      }

      .jof-mstock__row {
        display: flex;
        align-items: center;
        gap: 0.8rem;
      }

      .jof-mstock__dot {
        flex-shrink: 0;
        width: 0.8rem;
        height: 0.8rem;
        border-radius: 50%;
        background: #d92d20;
      }

      #{{ sticky_id }} .jof-sticky__dot {
        flex-shrink: 0;
        width: 0.8rem;
        height: 0.8rem;
        border-radius: 50%;
        background: {{ block.settings.dot_color }};
      }

      #{{ sticky_id }} .jof-sticky__inner {
        padding: 2.5rem 1.9rem 2rem;
      }

      #{{ sticky_id }} .jof-sticky__button {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        height: 4.7rem;
        padding: 0 1.6rem;
        border: 0;
        border-radius: 0;
        background: {{ block.settings.button_bg }};
        color: {{ block.settings.button_text }};
        font-family: inherit;
        font-size: 1.6rem;
        font-weight: 400;
        letter-spacing: 0.02em;
        text-transform: none;
        cursor: pointer;
      }

      #{{ sticky_id }} .jof-sticky__button[disabled] {
        opacity: 0.5;
        cursor: not-allowed;
      }
    }
  </style>

  {%- case request.locale.iso_code -%}
    {%- when 'fr' -%}{%- assign low_stock_text = 'Stock bientôt épuisé' -%}
    {%- when 'es' -%}{%- assign low_stock_text = 'Stock casi agotado' -%}
    {%- when 'nl' -%}{%- assign low_stock_text = 'Bijna uitverkocht' -%}
    {%- when 'ar' -%}{%- assign low_stock_text = 'المخزون على وشك النفاد' -%}
    {%- else -%}{%- assign low_stock_text = 'Almost sold out' -%}
  {%- endcase -%}
  {%- comment -%} Version courte sans « En stock » (même texte que dans le panier) {%- endcomment -%}
  {%- assign short_template = 'joeve.cart.delivered_between' | t -%}
  {%- assign short_text = short_template | replace: '[from]', labels[0] | replace: '[to]', labels[1] -%}
  <div class="jof-mstock" id="jof-mstock-{{ block.id }}">
    <div class="jof-mstock__row">
      <span
        data-jof-delivery
        data-min="{{ min_days }}"
        data-max="{{ max_days }}"
        data-business="{{ block.settings.count_business_days }}"
        data-template="{{ short_template | escape }}"
        data-locale="{{ request.locale.iso_code }}"
      >
        {{- short_text -}}
      </span>
    </div>
    <div class="jof-mstock__row">
      <span class="jof-mstock__dot" aria-hidden="true"></span>
      <span>{{ low_stock_text }}</span>
    </div>
  </div>

  <div id="{{ sticky_id }}" class="jof-sticky">
    {%- comment -%} Message promo à la place de la ligne livraison, dans la langue du visiteur {%- endcomment -%}
    {%- case request.locale.iso_code -%}
      {%- when 'fr' -%}
        {%- assign sticky_promo = 'PROMOTION SPÉCIALE AUTOMNE : profitez jusqu’à 50 % de réduction sur une sélection de produits – offre valable sur les stocks restants' -%}
      {%- when 'es' -%}
        {%- assign sticky_promo = 'PROMOCIÓN ESPECIAL DE OTOÑO: disfruta de hasta un 50 % de descuento en una selección de productos – oferta válida hasta agotar existencias' -%}
      {%- when 'nl' -%}
        {%- assign sticky_promo = 'SPECIALE HERFSTACTIE: tot 50% korting op een selectie producten – aanbieding geldig zolang de voorraad strekt' -%}
      {%- when 'ar' -%}
        {%- assign sticky_promo = 'عرض الخريف الخاص: استمتعي بخصم يصل إلى 50% على مجموعة مختارة من المنتجات – العرض ساري حتى نفاد الكمية' -%}
      {%- else -%}
        {%- assign sticky_promo = 'SPECIAL FALL PROMOTION: enjoy up to 50% off a selection of products – offer valid while stocks last' -%}
    {%- endcase -%}
    <div class="jof-sticky__band">
      <span class="jof-sticky__dot" aria-hidden="true"></span>
      <span class="jof-sticky__text">{{ sticky_promo }}</span>
    </div>
    <div class="jof-sticky__inner">
      <button type="button" class="jof-sticky__button" data-sold-out="{{ 'products.product.sold_out' | t | escape }}">{{ 'products.product.add_to_cart' | t }}</button>
    </div>
  </div>

  <script>
    (function () {
      var bar = document.currentScript && document.currentScript.previousElementSibling;
      if (!bar || !bar.classList.contains('jof-sticky')) return;
      var section = bar.closest('.shopify-section') || document;
      var stock = bar.previousElementSibling;

      // Retire une ancienne barre (rechargement dans l'éditeur) puis place celle-ci dans <body>
      document.querySelectorAll('#' + bar.id).forEach(function (el) { if (el !== bar) el.remove(); });
      document.body.appendChild(bar);
      document.body.classList.add('jof-has-sticky');

      // Sur téléphone, la ligne livraison + stock se place juste sous le prix
      if (stock && stock.classList.contains('jof-mstock')) {
        document.querySelectorAll('#' + stock.id).forEach(function (el) { if (el !== stock) el.remove(); });
        var price = section.querySelector('xo-product-will-change[xo-unique-id^="product-price-"]');
        if (price) price.insertAdjacentElement('afterend', stock);
      }

      var button = bar.querySelector('.jof-sticky__button');

      function holder() {
        return section.querySelector('[xo-unique-id^="add-to-cart-detail-"]');
      }

      function cart() {
        var h = holder();
        return h && h.querySelector('xo-cart-add, .xo-add-to-cart');
      }

      // Taille choisie épuisée (même repère que le sélecteur de tailles grisé)
      function soldOut() {
        var checked = section.querySelectorAll('.xo-field-toggle__input:checked, input[type="radio"]:checked');
        for (var i = 0; i < checked.length; i++) {
          if (checked[i].hasAttribute('xo-disabled') || checked[i].hasAttribute('xo-unavailable')) return true;
        }
        return false;
      }

      function sync() {
        var h = holder();
        if (h && !h.classList.contains('jof-hide-mobile')) h.classList.add('jof-hide-mobile');
        var c = cart();
        if (c) {
          var disabled = c.hasAttribute('xo-disabled') || soldOut();
          var label = '';
          if (disabled) {
            label = button.getAttribute('data-sold-out');
          } else {
            var inner = c.querySelector('button, [aria-label]');
            label = (inner && inner.getAttribute('aria-label')) || c.textContent;
          }
          label = (label || '').trim();
          if (label && button.textContent !== label) button.textContent = label;
          if (button.disabled !== disabled) button.disabled = disabled;
        }
      }

      button.addEventListener('click', function () {
        var c = cart();
        sync();
        if (!c || button.disabled) return;
        (c.querySelector('button') || c).click();
      });

      sync();
      section.addEventListener('change', function () { setTimeout(sync, 0); setTimeout(sync, 300); });
      var timer;
      new MutationObserver(function () {
        clearTimeout(timer);
        timer = setTimeout(sync, 50);
      }).observe(section, { subtree: true, childList: true, attributes: true, characterData: true });
    })();
  </script>
{%- endif -%}

<script>
  (function () {
    function addDays(start, count, business) {
      var date = new Date(start);
      if (!business) {
        date.setDate(date.getDate() + count);
        return date;
      }
      var added = 0;
      while (added < count) {
        date.setDate(date.getDate() + 1);
        var day = date.getDay();
        if (day !== 0 && day !== 6) added++;
      }
      return date;
    }

    function format(date, locale) {
      return date.toLocaleDateString(locale || 'en', { weekday: 'long', day: 'numeric', month: 'long' });
    }

    document.querySelectorAll('[data-jof-delivery]').forEach(function (el) {
      var today = new Date();
      var business = el.dataset.business === 'true';
      var from = addDays(today, parseInt(el.dataset.min, 10), business);
      var to = addDays(today, parseInt(el.dataset.max, 10), business);
      var template = el.dataset.template || '[from] – [to]';
      el.textContent = template.replace('[from]', format(from, el.dataset.locale)).replace('[to]', format(to, el.dataset.locale));
    });
  })();
</script>

