{%- liquid
  assign top = section.settings.space_top | append: 'px'
  assign bottom = section.settings.space_bottom | append: 'px'
  assign thickness = section.settings.thickness | append: 'px'
  assign width = section.settings.width | append: '%'
  assign opacity = section.settings.opacity | divided_by: 100.0
-%}

<style>
  #shopify-section-{{ section.id }} {
    display: none;
  }

  #shopify-section-{{ section.id }} .joeve-divider {
    padding: {{ top }} 0 {{ bottom }};
    background: {% if section.settings.transparent_bg %}transparent{% else %}{{ section.settings.bg_color }}{% endif %};
  }

  #shopify-section-{{ section.id }} .joeve-divider__line {
    width: {{ width }};
    height: 0;
    margin: 0 auto;
    border: 0;
    border-top: {{ thickness }} solid {{ section.settings.color }};
    opacity: {{ opacity }};
  }

  /* Visible uniquement sur téléphone */
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} {
      display: block;
    }
  }
</style>

<div class="joeve-divider">
  <hr class="joeve-divider__line">
</div>

{% schema %}
{
  "name": "Ligne fine (téléphone)",
  "tag": "div",
  "class": "joeve-divider-section",
  "settings": [
    {
      "type": "paragraph",
      "content": "Cette ligne s'affiche uniquement sur téléphone."
    },
    {
      "type": "color",
      "id": "color",
      "label": "Couleur de la ligne",
      "default": "#1A1A1A"
    },
    {
      "type": "range",
      "id": "opacity",
      "label": "Opacité de la ligne",
      "min": 5,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "range",
      "id": "thickness",
      "label": "Épaisseur",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "width",
      "label": "Largeur",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 90
    },
    {
      "type": "range",
      "id": "space_top",
      "label": "Espace au-dessus",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "space_bottom",
      "label": "Espace en dessous",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "checkbox",
      "id": "transparent_bg",
      "label": "Fond transparent",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Couleur du fond",
      "default": "#FDF9F6",
      "visible_if": "{{ section.settings.transparent_bg == false }}"
    }
  ],
  "presets": [
    {
      "name": "Ligne fine (téléphone)"
    }
  ]
}
{% endschema %}
